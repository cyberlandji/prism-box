# Elastic Stack version — pinned, never use :latest
STACK_VERSION=9.4.2

# Passwords — generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 24
# NEVER commit the real .env — this is a template only.
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme

CLUSTER_NAME=prismbox-cluster
ES_PORT=9200
KIBANA_PORT=5601

# Memory limits (bytes): ES 3GB container / Kibana 1GB
ES_MEM_LIMIT=3221225472
KIBANA_MEM_LIMIT=1073741824

LICENSE=basic
